# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Office lock files and OS clutter
~$*
Thumbs.db
.DS_Store

# Run logs (results are kept; logs are regenerated on each run)
PS Research/g0_gate/fetch_log.txt
PS Research/g0_gate/results/analysis_stdout.json
PS Research/g0_gate/results/analysis_stderr.txt
PS Research/g0_gate/results/settlement_check_log.txt

# MCX raw cache: rebuilt by `python -m tola.refresh`; hashes are kept in data/snapshot/raw_index.json.
# The spec PDFs are source documents for data/specs/gold.yaml, so they stay in git.
data/raw/*
!data/raw/specs/
data/snapshot/VALIDATION_FAILED.md
.pytest_cache/

# Web app build output
web/dist/
# Impeccable working files (design sidecar, surface briefs, review captures) stay local
.impeccable/
# Impeccable skill is installed per machine: npx skills add pbakaus/impeccable
.claude/skills/

# Launch video (brag-slim): output and the scene app that renders it
brag-output/
web/brag/
# Agent skills installed per machine (npx skills add ...)
.agents/
skills-lock.json
